  m_TableData:
  - m_Id: 6994638397440
    m_Localized: "Paina ja pid\xE4 [chat]-painiketta avataksesi ilmevalikon. Voit
      jopa yhdistell\xE4 niit\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 6759971282944
    m_Localized: "K\xE4yt\xE4 [grab]-painiketta pit\xE4ess\xE4si oikeaa k\xE4tt\xE4si
      esineen p\xE4\xE4ll\xE4 repussasi, ja tyhjenn\xE4 kaikki paikat t\xE4ytt\xE4\xE4ksesi
      edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 6700546383872
    m_Localized: "K\xE4yt\xE4 [grab]-painiketta oikealla k\xE4dell\xE4si ottaaksesi
      esineen repustasi."
    m_Metadata:
      m_Items: []
  - m_Id: 6627842318336
    m_Localized: "Nappaa ([grab]) esine, pid\xE4 sit\xE4 ja aseta se yhteen kolmesta
      edess\xE4si olevasta paikasta. T\xE4yt\xE4 kaikki paikat repussasi t\xE4ytt\xE4\xE4ksesi
      edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 6919544832
    m_Localized: "Nappaa esine ja aseta se yhteen edess\xE4si olevista paikoista
      laittaaksesi sen reppuusi."
    m_Metadata:
      m_Items: []
  - m_Id: 6878309376000
    m_Localized: "K\xE4yt\xE4 vasenta ([MapGrabLeft]) tai oikeaa ([MapGrabRight])
      k\xE4tt\xE4si ja paina vastaavaa painiketta noutaaksesi ja tarkastellaksesi
      karttaa, kunnes olet t\xE4ytt\xE4nyt edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 6811674468352
    m_Localized: "K\xE4yt\xE4 [MapGrabLeft] tai [MapGrabRight] napata ja tarkastella
      karttaa. Kartta on <b><u>t\xE4rke\xE4</b></u> navigoinnin kannalta."
    m_Metadata:
      m_Items: []
  - m_Id: 21867436612509696

  - m_Id: 22130987235270656
    m_Localized: "P\xE4\xE4ll\xE4"
    m_Metadata:
      m_Items: []
  - m_Id: 22131282518466560
    m_Localized: Kameran kuvataajuus
    m_Metadata:
      m_Items: []
  - m_Id: 22131445974687744
    m_Localized: Kameran FOV
    m_Metadata:
      m_Items: []
  - m_Id: 22131576966995968
    m_Localized: Kameran pehmennys
    m_Metadata:
      m_Items: []
  - m_Id: 22140940561932288
    m_Localized: "Is\xE4nn\xE4lt\xE4 puuttuu VR-modi"
    m_Metadata:
      m_Items: []
  - m_Id: 22141160662228992
    m_Localized: "Is\xE4nn\xE4ll\xE4 ei n\xE4yt\xE4 olevan VR-modia asennettuna.\n\nJotkin
      VR-ominaisuudet eiv\xE4t v\xE4ltt\xE4m\xE4tt\xE4 toimi tai niiden toimivuus
      on heikentynyt."
    m_Metadata:
      m_Items: []
  - m_Id: 22141383878893568
    m_Localized: "Se on, mit\xE4 se on"
    m_Metadata:
      m_Items: []
  - m_Id: 22142401945526272
    m_Localized: "RepoXR yritti k\xE4ynnist\xE4\xE4 pelin VR-tilassa, mutta alustuksen
      aikana tapahtui virhe.\n\nPystyt silti pelaamaan peli\xE4 ja k\xE4ytt\xE4m\xE4\xE4n
      t\xE4m\xE4n modin ominaisuuksia, mutta et ole VR-tilassa.\n\nVoit poistaa VR:n
      k\xE4yt\xF6st\xE4 asetuksista, jos haluat est\xE4\xE4 t\xE4m\xE4n virheen tulevaisuudessa."
    m_Metadata:
      m_Items: []
  - m_Id: 22142412309651456
    m_Localized: "Selv\xE4 juttu"
    m_Metadata:
      m_Items: []
  - m_Id: 22142419381248000
    m_Localized: "VR-k\xE4ynnistys ep\xE4onnistui"
    m_Metadata:
      m_Items: []
  - m_Id: 22153268758044672
    m_Localized: VR-kehitysversio
    m_Metadata:
      m_Items: []
  - m_Id: 22153422554783744
    m_Localized: Anna minun pelata!
    m_Metadata:
      m_Items: []
  - m_Id: 22153575793680384
    m_Localized: "K\xE4yt\xE4t RepoXR:n kehitysversiota. T\xE4m\xE4 versio ei ole
      valmis ja se saattaa sis\xE4lt\xE4\xE4 bugeja tai muita odottamattomia \"ominaisuuksia\".\n\nJatka
      varovasti."
    m_Metadata:
      m_Items: []

  m_Name: RepoXR_sv-SE
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: sv-SE
  m_SharedData: {fileID: 11400000, guid: feec7f8a9e0eaef4581f6aaf60f063a5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22153575793680384
    m_Localized: "Du anv\xE4nder en utvecklingsversion av RepoXR. Denna version \xE4r
      inte f\xE4rdig och kan inneh\xE5lla buggar eller andra of\xF6rutsedda \"funktioner\".\n\nForts\xE4tt
      med f\xF6rsiktighet."
    m_Metadata:
      m_Items: []
  - m_Id: 6919544832
    m_Localized: "Ta ett f\xF6rem\xE5l och l\xE4gg det i en av platserna framf\xF6r
      dig f\xF6r att placera det i ditt inventarium."
    m_Metadata:
      m_Items: []
  - m_Id: 6627842318336
    m_Localized: "Ta ([grab]) ett f\xF6rem\xE5l, h\xE5ll det och l\xE4gg det i en
      av de tre platserna framf\xF6r dig. Fyll alla platser i ditt inventarium f\xF6r
      att slutf\xF6ra f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 6700546383872
    m_Localized: "Anv\xE4nd [grab] med din h\xF6gra hand f\xF6r att ta ut ett f\xF6rem\xE5l
      ur ditt inventarium."
    m_Metadata:
      m_Items: []
  - m_Id: 6759971282944
    m_Localized: "Anv\xE4nd [grab] medan du h\xE5ller din h\xF6gra hand \xF6ver ett
      f\xF6rem\xE5l i ditt inventarium, och t\xF6m alla platser f\xF6r att fylla
      f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 6811674468352
    m_Localized: "Anv\xE4nd [MapGrabLeft] eller [MapGrabRight] f\xF6r att ta och
      titta p\xE5 kartan. Kartan \xE4r <b><u>viktig</b></u> f\xF6r navigering."
    m_Metadata:
      m_Items: []
  - m_Id: 6878309376000
    m_Localized: "Anv\xE4nd din v\xE4nstra ([MapGrabLeft]) eller h\xF6gra ([MapGrabRight])
      hand och tryck p\xE5 respektive knapp f\xF6r att ta upp och titta p\xE5 kartan
      tills du har fyllt f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 6994638397440
    m_Localized: "H\xE5ll [chat]-knappen intryckt f\xF6r att \xF6ppna uttryckshjulet.
      Du kan till och med mixa!"
    m_Metadata:
      m_Items: []

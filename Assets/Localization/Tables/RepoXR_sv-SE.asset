      m_Items: []
  - m_Id: 22131445974687744
    m_Localized: Kamera FOV
    m_Metadata:
      m_Items: []
  - m_Id: 22131576966995968
    m_Localized: "Kamerautj\xE4mning"
    m_Metadata:
      m_Items: []
  - m_Id: 22140940561932288
    m_Localized: "V\xE4rden saknar VR-mod"
    m_Metadata:
      m_Items: []
  - m_Id: 22141160662228992
    m_Localized: "V\xE4rden verkar inte ha VR-modden installerad.\n\nVissa VR-funktioner
      kanske inte fungerar, eller har nedsatt funktionalitet."
    m_Metadata:
      m_Items: []
  - m_Id: 22141383878893568
    m_Localized: "Det \xE4r som det \xE4r"
    m_Metadata:
      m_Items: []
  - m_Id: 22142401945526272
    m_Localized: "RepoXR f\xF6rs\xF6kte starta spelet i VR, men ett fel uppstod under
      initieringen.\n\nDu kommer fortfarande att kunna spela spelet och anv\xE4nda
      denna mods funktioner, men du kommer inte att vara i VR.\n\nDu kan inaktivera
      VR i inst\xE4llningarna om du vill undertrycka detta fel i framtiden."
    m_Metadata:
      m_Items: []
  - m_Id: 22142412309651456
    m_Localized: "Okej d\xE5"
    m_Metadata:
      m_Items: []
  - m_Id: 22142419381248000
    m_Localized: VR-start misslyckades
    m_Metadata:
      m_Items: []
  - m_Id: 22153268758044672
    m_Localized: VR-utvecklingsversion
    m_Metadata:
      m_Items: []
  - m_Id: 22153422554783744
    m_Localized: "L\xE5t mig spela!"
    m_Metadata:
      m_Items: []
  - m_Id: 22053301024448512
    m_Localized: Tillbaka
    m_Metadata:
      m_Items: []

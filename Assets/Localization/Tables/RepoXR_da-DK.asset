  - m_Id: 22131282518466560
    m_Localized: Kamera-billedfrekvens
    m_Metadata:
      m_Items: []
  - m_Id: 22131445974687744
    m_Localized: Kamera FOV
    m_Metadata:
      m_Items: []
  - m_Id: 22131576966995968
    m_Localized: "Kameraudj\xE6vning"
    m_Metadata:
      m_Items: []
  - m_Id: 22140940561932288
    m_Localized: "V\xE6rt mangler VR-mod"
    m_Metadata:
      m_Items: []
  - m_Id: 22141160662228992
    m_Localized: "V\xE6rten ser ikke ud til at have VR-mod'et installeret.\n\nNogle
      VR-funktioner virker muligvis ikke, eller har forringet funktionalitet."
    m_Metadata:
      m_Items: []
  - m_Id: 22141383878893568
    m_Localized: Det er som det er
    m_Metadata:
      m_Items: []
  - m_Id: 22142401945526272
    m_Localized: "RepoXR fors\xF8gte at starte spillet i VR, men der opstod en fejl
      under initialiseringen.\n\nDu vil stadig kunne spille spillet og bruge denne
      mods funktioner, men du vil ikke v\xE6re i VR.\n\nDu kan deaktivere VR i indstillingerne,
      hvis du vil undertrykke denne fejl i fremtiden."
    m_Metadata:
      m_Items: []
  - m_Id: 22142412309651456
    m_Localized: Okay, venner
    m_Metadata:
      m_Items: []
  - m_Id: 22142419381248000
    m_Localized: VR-start mislykkedes
    m_Metadata:
      m_Items: []
  - m_Id: 22153268758044672
    m_Localized: VR-udviklingsversion
    m_Metadata:
      m_Items: []
  - m_Id: 22153422554783744
    m_Localized: Lad mig spille!
    m_Metadata:
      m_Items: []
  - m_Id: 22153575793680384
    m_Localized: "Du bruger en udviklingsversion af RepoXR. Denne version er ikke
      f\xE6rdig og kan indeholde fejl eller andre uforudsete \"funktioner\".\n\nForts\xE6t
      med forsigtighed."
    m_Metadata:
      m_Items: []

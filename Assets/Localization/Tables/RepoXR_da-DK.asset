  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: RepoXR_da-DK
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: da-DK
  m_SharedData: {fileID: 11400000, guid: feec7f8a9e0eaef4581f6aaf60f063a5, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6994638397440
    m_Localized: "Tryk og hold [chat]-knappen nede for at \xE5bne udtrykshjulet.
      Du kan endda blande!"
    m_Metadata:
      m_Items: []
  - m_Id: 6759971282944
    m_Localized: "Brug [grab], mens du holder din h\xF8jre h\xE5nd over en genstand
      i dit inventar, og t\xF8m alle pladser for at udfylde statuslinjen!"
    m_Metadata:
      m_Items: []
  - m_Id: 6700546383872
    m_Localized: "Brug [grab] med din h\xF8jre h\xE5nd til at tage en genstand ud
      af dit inventar."
    m_Metadata:
      m_Items: []
  - m_Id: 6627842318336
    m_Localized: "Tag ([grab]) en genstand, hold den, og l\xE6g den i en af de tre
      pladser foran dig. Fyld alle pladser i dit inventar for at udfylde statuslinjen!"
    m_Metadata:
      m_Items: []
  - m_Id: 6919544832
    m_Localized: "Tag en genstand, og l\xE6g den i en af pladserne foran dig for
      at placere den i dit inventar."
    m_Metadata:
      m_Items: []
  - m_Id: 6878309376000
    m_Localized: "Brug din venstre ([MapGrabLeft]) eller h\xF8jre ([MapGrabRight])
      h\xE5nd, og tryk p\xE5 den respektive knap for at tage og se kortet, indtil
      du har udfyldt statuslinjen!"
    m_Metadata:
      m_Items: []
  - m_Id: 6811674468352
    m_Localized: Brug [MapGrabLeft] eller [MapGrabRight] til at tage og se kortet.
      Kortet er <b><u>vigtigt</b></u> for navigation.
    m_Metadata:
      m_Items: []
